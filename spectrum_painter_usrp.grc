options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: spectrum_painter
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Spectrum Painter
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: fft_size
  id: variable
  parameters:
    comment: ''
    value: 2**(two_power+1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 40.0]
    rotation: 0
    state: enabled
- name: imageWidth
  id: variable
  parameters:
    comment: ''
    value: '1600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 24.0]
    rotation: 0
    state: enabled
- name: outputGain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Output Gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-100'
    step: '0.1'
    stop: '20'
    value: '-33'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 824.0]
    rotation: 0
    state: enabled
- name: repeatVal
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: Repeat Value
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '1'
    step: '1'
    stop: '1000'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 584.0]
    rotation: 0
    state: enabled
- name: rf_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: RF Gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.2'
    stop: '89.8'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 832.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 1e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: two_power
  id: variable
  parameters:
    comment: ''
    value: int(np.log(imageWidth)/np.log(2))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [448, 136.0]
    rotation: 0
    state: enabled
- name: zeropad_left
  id: variable
  parameters:
    comment: ''
    value: int((fft_size-imageWidth)/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 40.0]
    rotation: 0
    state: enabled
- name: zeropad_right
  id: variable
  parameters:
    comment: ''
    value: int(fft_size-imageWidth-zeropad_left)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 40.0]
    rotation: 0
    state: enabled
