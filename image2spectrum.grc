    rotation: 0
    state: enabled
- name: max_level
  id: variable_qtgui_range
  parameters:
    comment: 'Use this to adjust the reference

      level of the waterfall sink.'
    gui_hint: ''
    label: Maximum Spectrogram Level
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-160'
    step: '1'
    stop: '70'
    value: '-38'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 584.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
